cabal-version: 3.0
name: circuits-diff
version: 0.1.0.0
license: BSD-3-Clause
license-file: LICENSE
copyright: Tony Day (c) 2025
category: math
author: Tony Day
maintainer: tonyday567@gmail.com
homepage: https://github.com/tonyday567/circuits-diff#readme
bug-reports: https://github.com/tonyday567/circuits-diff/issues
synopsis: Reverse-mode automatic differentiation for circuits.
description:
  circuits-diff provides the 'Diff' carrier and the circuits ecosystem's
  automatic-differentiation toolkit: jets, inverse functions, reverse
  differential categories, curvature, charts, star-elimination, and
  parameterised differentiable arrows.  Everything lives under the
  'Circuit.Diff' namespace.
build-type: Simple
tested-with:
  ghc ==9.10.1
  ghc ==9.12.2
  ghc ==9.14.1
extra-doc-files:
  ChangeLog.md
  readme.md

source-repository head
  type: git
  location: https://github.com/tonyday567/circuits-diff

common ghc-options-stanza
  ghc-options:
    -Wall
    -Wno-unused-imports
    -Wcompat
    -Widentities
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wpartial-fields
    -Wredundant-constraints

  if impl(ghc >=9.14)
    ghc-options: -Wno-pattern-namespace-specifier

library
  import: ghc-options-stanza
  default-language: GHC2024
  hs-source-dirs: src
  exposed-modules:
    Circuit.Diff
    Circuit.Diff.Backprop
    Circuit.Diff.Carrier
    Circuit.Diff.Chart
    Circuit.Diff.Circuit
    Circuit.Diff.Curvature
    Circuit.Diff.Curvature.Surface
    Circuit.Diff.DubinsChase
    Circuit.Diff.Eliminate
    Circuit.Diff.Inverse
    Circuit.Diff.Jacobian
    Circuit.Diff.Jet
    Circuit.Diff.Metric
    Circuit.Diff.Newton
    Circuit.Diff.Operators
    Circuit.Diff.Param
    Circuit.Diff.Pullback
    Circuit.Diff.RDC
    Circuit.Diff.Star
    Circuit.Diff.Taylor
    Circuit.Diff.Expr
    Circuit.Diff.Tensor

  build-depends:
    base >=4.20 && <5,
    circuits >=0.3 && <0.4,
    circuits-mat >=0.1 && <0.2,
    harpie >=0.3 && <0.4,
    numhask >=0.14 && <0.15,

executable circuits-diff-axioma
  import: ghc-options-stanza
  default-language: GHC2024
  main-is: axioma.hs
  hs-source-dirs: app
  other-modules:
    Curvature
    DiffCarrierTests
    DubinsChase
    GeodesicFlow
    Kepler
    MatrixStar
    MetricAdjoint
    Operators
    StarEliminate
    Tags
    Tensor
  build-depends:
    base >=4.20 && <5,
    circuits,
    circuits-diff,
    circuits-mat,
    harpie >=0.3 && <0.4,
    numhask >=0.14 && <0.15,
